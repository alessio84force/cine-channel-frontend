export default function LegalLayout({ title, children }:{
  title: string; children: React.ReactNode;
}) {
  return (
    <main className="max-w-3xl mx-auto px-6 py-10">
      <h1 className="text-3xl font-bold mb-2">{title}</h1>
      <p className="text-white/50 text-sm mb-6">
        {COMPANY.name} · {COMPANY.address}, {COMPANY.zip} {COMPANY.city}, {COMPANY.country} · {COMPANY.vatNumber || "VAT"} · {COMPANY.website}
      </p>
      <article className="prose prose-invert prose-sm sm:prose-base max-w-none">{children}</article>
      <hr className="my-8 border-white/10" />
      <div className="text-xs text-white/50">
        © {new Date().getFullYear()} {COMPANY.shortName || COMPANY.name}. Todos los derechos reservados.
        {" · "} <Link className="underline" href="/es/privacy">Privacidad</Link>
        {" · "} <Link className="underline" href="/es/cookies">Cookies</Link>
        {" · "} <Link className="underline" href="/es/terms">Términos</Link>
        {" · "} <Link className="underline" href="/es/dmca">Copyright</Link>
        {" · "} <Link className="underline" href="/es/contact">Contacto</Link>
      </div>
    </main>
  );
}
