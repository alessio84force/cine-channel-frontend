export const ACCESS_2025: Record<string,string> = {
en:`<h2>Accessibility (2025)</h2><p>We strive to meet WCAG 2.2 AA. Keyboard navigation, captions, transcripts, high-contrast themes and screen-reader labels are supported.</p><p>Report issues: accessibility@cine-channel.example</p>`,
es:`<h2>Accesibilidad (2025)</h2><p>Apuntamos a WCAG 2.2 AA. Navegación por teclado, subtítulos, transcripciones, alto contraste y etiquetas para lectores de pantalla.</p><p>Informar problemas: accessibility@cine-channel.example</p>`,
it:`<h2>Accessibilità (2025)</h2><p>Miriamo a WCAG 2.2 AA. Navigazione tastiera, sottotitoli, trascrizioni, contrasto elevato e etichette screen reader.</p>`,
fr:`<h2>Accessibilité (2025)</h2><p>Objectif WCAG 2.2 AA. Clavier, sous-titres, transcriptions, contraste, lecteurs d’écran.</p>`,
de:`<h2>Barrierefreiheit (2025)</h2><p>Ziel WCAG 2.2 AA. Tastaturbedienung, Untertitel, Transkripte, hoher Kontrast.</p>`,
pt:`<h2>Acessibilidade (2025)</h2><p>WCAG 2.2 AA. Teclado, legendas, transcrições, alto contraste.</p>`,
ar:`<h2>إمكانية الوصول (2025)</h2><p>نستهدف WCAG 2.2 AA. تنقل بلوحة المفاتيح، ترجمات، نصوص، تباين عالٍ.</p>`,
ru:`<h2>Доступность (2025)</h2><p>Цель WCAG 2.2 AA. Клавиатура, субтитры, транскрипции, высокий контраст.</p>`,
zh:`<h2>无障碍（2025）</h2><p>目标 WCAG 2.2 AA：键盘导航、字幕、转录、高对比度、读屏支持。</p>`,
ko:`<h2>접근성 (2025)</h2><p>WCAG 2.2 AA 목표. 키보드, 자막, 대본, 고대비, 스크린리더.</p>`
