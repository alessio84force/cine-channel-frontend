import { NextResponse, NextRequest } from 'next/server';

const locales = ['es','en','fr','en-us'] as const;

function mapCountryToLocale(country?: string): 'es'|'en'|'fr'|'en-us' {
  const c = (country || '').toUpperCase();
  if (c === 'ES') return 'es';
  if (c === 'FR') return 'fr';
  if (c === 'US') return 'en-us';
  return 'en';
}

function fallbackFromAcceptLanguage(header?: string): 'es'|'en'|'fr'|'en-us' {
  const h = (header || '').toLowerCase();
  if (h.startsWith('es')) return 'es';
  if (h.startsWith('fr')) return 'fr';
  return 'en';
}

export function middleware(req: NextRequest) {
  const { pathname } = req.nextUrl;
  const seg = pathname.split('/').filter(Boolean)[0];

  if (seg && (locales as readonly string[]).includes(seg)) {
    return NextResponse.next();
  }

  const geoCountry = (req.geo && (req.geo as any).country) || req.headers.get('x-vercel-ip-country') || undefined;
  const accept = req.headers.get('accept-language') || undefined;

  const guess = geoCountry ? mapCountryToLocale(geoCountry) : fallbackFromAcceptLanguage(accept);

  const url = req.nextUrl.clone();
  url.pathname = `/${guess}` + (pathname === '/' ? '' : pathname);
  return NextResponse.redirect(url);
}

export const config = {
  matcher: [
    '/((?!_next/static|_next/image|favicon.ico|robots.txt|sitemap.xml|\\.well-known|.*\\.(?:png|jpg|jpeg|svg|webp|gif|ico)).*)'
  ],
};
